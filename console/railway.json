{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/console/Dockerfile",
    "watchPatterns": [
      "console/**"
    ]
  },
  "deploy": {
    "sleepApplication": true,
    "drainingSeconds": 15,
    "overlapSeconds": 10
  }
}
